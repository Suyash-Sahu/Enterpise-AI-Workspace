# =============================================================================
# Core Platform Service — environment template
# Copy to .env and fill in. Every key below is read by app/core/config.py.
# =============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/core_platform_db
# Development only. When the database is unreachable the app fails to start
# unless this is true, in which case it falls back to a local SQLite file.
ALLOW_SQLITE_FALLBACK=false

# --- Security ----------------------------------------------------------------
# REQUIRED. Minimum 32 characters — the app refuses to start below that.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# REQUIRED. Encrypts stored Google OAuth tokens at rest. No default on purpose:
# the previous fallback was a literal published in this file.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Session cookies ---------------------------------------------------------
# This service issues and clears the session itself. Cookies are httpOnly,
# and SameSite=strict so the browser will not attach them to a cross-site
# request — which is why the Next app must proxy /api/v1/* rather than the
# browser calling this service on another origin.
#
# COOKIE_SECURE defaults to on in production and off in development, because a
# Secure cookie is never sent over the plain-http dev server and the result
# looks exactly like a broken login. Override only if you know why.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=
# ACCESS_COOKIE_NAME=amof_access
# REFRESH_COOKIE_NAME=amof_refresh

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# --- Frontend & CORS ---------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins, comma-separated. FRONTEND_URL is always
# allowed and does not need repeating.
CORS_ORIGINS=

# --- Rate limiting -----------------------------------------------------------
# Leave the storage URI empty for in-process counters. Set a redis:// URI once
# you run more than one worker, or each worker keeps its own counts.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=3/minute
RATE_LIMIT_REFRESH=20/minute
RATE_LIMIT_EXPENSIVE=20/minute

# --- Google connector --------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Where Google returns the browser after CONNECTING Gmail/Drive.
#
# Leave this EMPTY. Connecting then rides the sign-in callback below and is
# told apart by the state row's purpose, so exactly ONE redirect URI has to be
# registered with Google. Anything unregistered is refused before consent with
# "Error 400: redirect_uri_mismatch".
#
# Set it only to opt back into the dedicated connector callback at
# {FRONTEND_URL}/api/v1/connectors/google/oauth/callback, which then has to be
# registered in Google Cloud Console as well.
GOOGLE_REDIRECT_URI=

# Where Google returns the browser after SIGNING IN. This must be an address
# the browser can reach, which is the Next origin, because that is what
# proxies /api/v1/* to this service. Defaults to
# {FRONTEND_URL}/api/v1/auth/google/callback when unset.
# This is the only redirect URI that must be registered on the OAuth client in
# Google Cloud Console, unless GOOGLE_REDIRECT_URI above is also set.
GOOGLE_SIGNIN_REDIRECT_URI=

# --- AI models ---------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_DEFAULT_MODEL=openai/gpt-4o-mini

# --- RAG ---------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RRF_K=60

# --- Cache (optional; requires Redis) ----------------------------------------
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_NAMESPACE=amof
CACHE_SCHEMA_VERSION=v1
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_RAG_TTL_SECONDS=900
CACHE_GENERATION_TTL_SECONDS=600
CACHE_MAX_RESULT_SIZE=1048576
CACHE_SEMANTIC_ENABLED=false
CACHE_SEMANTIC_THRESHOLD=0.92
