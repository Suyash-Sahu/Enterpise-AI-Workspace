# ==============================================================================
# Enterprise AI Workspace — Backend .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example
credentials.json
**/credentials.json
client_secret*.json

# Databases & Local Logs
*.db
*.sqlite
*.sqlite3
fallback.db
*.log
logs/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/

# Build & Dist
build/
dist/
*.egg-info/

# Evaluation run outputs are regenerated by the test suite
**/evaluation/artifacts/
