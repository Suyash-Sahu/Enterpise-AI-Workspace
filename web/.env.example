APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where Next proxies /api/v1/* (see next.config.ts). Server-side only: the
# browser never sees this address and never calls the API directly.
#
# The proxy is not a convenience. Sessions are httpOnly cookies with
# SameSite=strict, which the browser sends only on same-site requests. If the
# browser called the API on another origin the cookie would be dropped every
# time and the user would look permanently signed out.
BACKEND_INTERNAL_URL=http://127.0.0.1:8001

# NOTE: this app holds no auth configuration any more.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET moved to the backend, which now owns
# the whole Google sign-in round trip. INTERNAL_AUTH_SECRET is gone with the
# server-to-server identity exchange it authenticated: there is no longer a
# second system to hand identities to. NEXT_PUBLIC_API_URL is gone because the
# API is always same-origin at /api/v1. JWT_SECRET and COOKIE_NAME were
# already unused.
