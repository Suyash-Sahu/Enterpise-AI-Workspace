# ==============================================================================
# Enterprise AI Workspace — Web Frontend .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Next.js Build Output & Cache
.next/
out/
build/
dist/
.turbo/
tsconfig.tsbuildinfo

# Environment & Secret Files
.env
.env*.local
!.env.example

# Logs & Testing
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# OS & IDE Files
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/

# A nested .git directory was committed here once; never again
.git_disabled/
